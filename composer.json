{
    "name": "bmsuisse/onedesk",
    "description": "Free self-hosted helpdesk and shared mailbox (Zendesk / Help Scout alternative)",
    "keywords": [
        "helpdesk",
        "help desk",
        "shared mailbox"
    ],
    "license": "AGPL-3.0",
    "authors": [
        {
            "name": "The FreeScout Team",
            "email": "dominik.peter@bmsuisse.ch"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-zip": "*",
        "barryvdh/laravel-translation-manager": "*",
        "devfactory/minify": "*",
        "doctrine/dbal": "^3.8",
        "enshrined/svg-sanitize": "0.22.0",
        "guzzlehttp/guzzle": "^7.5",
        "html2text/html2text": "4.1.0",
        "javoscript/laravel-macroable-models": "1.0.4",
        "laravel/framework": "^12.0",
        "laravel/helpers": "^1.4",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.6",
        "nwidart/laravel-modules": "2.7.0",
        "rachidlaasri/laravel-installer": "4.0.2",
        "rap2hpoutre/laravel-log-viewer": "*",
        "spatie/laravel-activitylog": "^4.10",
        "symfony/polyfill-intl-idn": "*",
        "tormjens/eventy": "0.5.4",
        "watson/rememberable": "*",
        "webklex/php-imap": "4.1.1",
        "ezyang/htmlpurifier": "^4.19"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.5",
        "fakerphp/faker": "^1.9"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories",
            "overrides/natxet/cssmin/src/",
            "overrides/erusev/parsedown/"
        ],
        "files": [
            "app/Misc/Functions.php",
            "overrides/mews/purifier/src/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Webklex\\PHPIMAP\\": "overrides/webklex/php-imap/src/",
            "RachidLaasri\\LaravelInstaller\\Helpers\\": "overrides/rachidlaasri/laravel-installer/src/Helpers/",
            "RachidLaasri\\LaravelInstaller\\Middleware\\": "overrides/rachidlaasri/laravel-installer/src/Middleware/",
            "RachidLaasri\\LaravelInstaller\\Controllers\\": "overrides/rachidlaasri/laravel-installer/src/Controllers/",
            "RachidLaasri\\LaravelInstaller\\Providers\\": "overrides/rachidlaasri/laravel-installer/src/Providers/",
            "RachidLaasri\\LaravelInstaller\\Events\\": "overrides/rachidlaasri/laravel-installer/src/Events/",
            "Nwidart\\Modules\\": "overrides/nwidart/laravel-modules/src/",
            "Nwidart\\Modules\\Generators\\": "overrides/nwidart/laravel-modules/src/Generators/",
            "TorMorten\\Eventy\\": "overrides/tormjens/eventy/src/",
            "Rap2hpoutre\\LaravelLogViewer\\": "overrides/rap2hpoutre/laravel-log-viewer/src/Rap2hpoutre/LaravelLogViewer/",
            "Javoscript\\MacroableModels\\": "overrides/javoscript/laravel-macroable-models/src/",
            "Html2Text\\": "overrides/html2text/html2text/src/",
            "Codedge\\Updater\\": "overrides/codedge/laravel-selfupdater/src/",
            "Lord\\Laroute\\": "overrides/lord/laroute/src/",
            "Axn\\Laroute\\": "overrides/axn/laravel-laroute/src/",
            "Barryvdh\\TranslationManager\\": "overrides/barryvdh/laravel-translation-manager/src/",
            "Mews\\Purifier\\": "overrides/mews/purifier/src/"
        },
        "exclude-from-classmap": [
            "Modules/",
            "vendor/rachidlaasri/laravel-installer/src/Helpers/RequirementsChecker.php",
            "vendor/rachidlaasri/laravel-installer/src/Helpers/PermissionsChecker.php",
            "vendor/rachidlaasri/laravel-installer/src/Helpers/EnvironmentManager.php",
            "vendor/rachidlaasri/laravel-installer/src/Helpers/FinalInstallManager.php",
            "vendor/rachidlaasri/laravel-installer/src/Helpers/InstalledFileManager.php",
            "vendor/rachidlaasri/laravel-installer/src/Helpers/DatabaseManager.php",
            "vendor/rachidlaasri/laravel-installer/src/Middleware/canInstall.php",
            "vendor/rachidlaasri/laravel-installer/src/Controllers/EnvironmentController.php",
            "vendor/rachidlaasri/laravel-installer/src/Controllers/FinalController.php",
            "vendor/rachidlaasri/laravel-installer/src/Events/EnvironmentSaved.php",
            "vendor/nwidart/laravel-modules/src/Module.php",
            "vendor/nwidart/laravel-modules/src/Repository.php",
            "vendor/nwidart/laravel-modules/src/Json.php",
            "vendor/nwidart/laravel-modules/src/Generators/ModuleGenerator.php",
            "vendor/rachidlaasri/laravel-installer/src/Providers/LaravelInstallerServiceProvider.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "pre-install-cmd": [
            "@php -r \"@mkdir('vendor/natxet/cssmin/src', 775);\""
        ],
        "post-autoload-dump": [
            "@php -r \"(error_reporting(0) || !error_reporting(0)) && array_map('unlink', json_decode(file_get_contents('composer.json'), true)['autoload']['exclude-from-classmap']);\"",
            "@php -r \"file_put_contents('vendor/webklex/php-imap/src/config/imap.php', preg_replace('/, \\\\'inline\\\\'],/s', '/*, \\\\'inline\\\\'*/],', file_get_contents('vendor/webklex/php-imap/src/config/imap.php')));\"",
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0"
        }
    }
}